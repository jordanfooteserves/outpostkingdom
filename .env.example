# ============================================================
#  Project starter — environment variables
#  Copy this file to ".env.local" and fill in real values.
#  NEVER commit ".env.local" — it is already in .gitignore.
#  In production, set these same values in:
#  Vercel → Project → Settings → Environment Variables
# ============================================================

# --- Airtable (only needed if this project stores/reads data) ---
# Personal Access Token from https://airtable.com/create/tokens (starts with "pat...")
AIRTABLE_API_TOKEN=your_airtable_personal_access_token_here

# Base ID from https://airtable.com/api (starts with "app...")
AIRTABLE_BASE_ID=your_airtable_base_id_here

# Name of the table the example API route reads (change to your table)
AIRTABLE_TABLE=Items
